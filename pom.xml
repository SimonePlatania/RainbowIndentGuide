<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!--
		Builds the plug-in, runs its tests and makes the update site with Tycho: mvn clean verify
		The versions are the ones of META-INF/MANIFEST.MF and feature.xml, the modules have no pom.xml.
	-->
	<modelVersion>4.0.0</modelVersion>
	<groupId>alien.rainbow.indentguide</groupId>
	<artifactId>alien.rainbow.indentguide.root</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<modules>
		<module>alien.rainbow.indentguide</module>
		<module>alien.rainbow.indentguide.tests</module>
		<module>alien.rainbow.indentguide.feature</module>
		<module>alien.rainbow.indentguide.repository</module>
	</modules>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- A dated release, so that the same commit keeps building: to be moved on on purpose -->
		<eclipse-repo.url>https://download.eclipse.org/releases/2026-09</eclipse-repo.url>
	</properties>
	<repositories>
		<repository>
			<id>eclipse-release</id>
			<url>${eclipse-repo.url}</url>
			<layout>p2</layout>
		</repository>
	</repositories>
	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho-version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-packaging-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<!-- the jars as build.sh makes them, without a Maven descriptor -->
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<!-- The plug-in declares Java 8 to keep loading on old releases, but the current Eclipse needs 21 -->
					<executionEnvironment>JavaSE-21</executionEnvironment>
					<environments>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>aarch64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>aarch64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-surefire-plugin</artifactId>
					<version>${tycho-version}</version>
					<configuration>
						<!-- The tests paint editors: they need a display (xvfb-run on a server). -->
						<useUIHarness>true</useUIHarness>
						<useUIThread>true</useUIThread>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
